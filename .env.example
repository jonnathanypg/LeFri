# =========================================================================
# LeFriApp - Open Source Environment Variables Template (.env.example)
# Platform for Democratic Legal Access, Multi-Agent AI & Human Rights
# =========================================================================

# 1. SERVER CONFIGURATION
NODE_ENV=development
PORT=8080
SESSION_SECRET=your_super_secret_session_key_min_32_chars
APP_URL=http://localhost:8080
DISABLE_SECURE_COOKIE=true

# 2. DATABASE CONFIGURATION (MySQL / MariaDB via Prisma ORM)
DATABASE_URL="mysql://lefri_user:secure_password@localhost:3306/lefri_ai"
DB_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"

# 3. GOOGLE OAUTH 2.0 (Optional for Local Citizen/Lawyer Login)
GOOGLE_OAUTH_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:8080/api/auth/google/callback"

# 4. ARTIFICIAL INTELLIGENCE & LLM ORCHESTRATION
DEFAULT_LLM_PROVIDER=openai # Options: openai | gemini | groq
DEFAULT_LLM_MODEL=gpt-4o-mini # Options: gpt-4o-mini | gemini-1.5-flash | llama-3.3-70b-versatile

OPENAI_API_KEY="sk-..."
GEMINI_API_KEY="AIzaSy..."
GROQ_API_KEY="gsk_..."

# Web Grounding (Real-time legal reforms and jurisprudential search)
TAVILY_API_KEY="tvly-..."

# Vector Store (RAG Grounding with national laws and international treaties)
PINECONE_API_KEY="pcsk_..."
PINECONE_INDEX="lefri-legal-knowledge"
PINECONE_ENVIRONMENT="us-east-1"

# The Constitute Project API (International Constitutional comparison)
CONSTITUTE_API_BASE_URL="https://www.constituteproject.org/service"

# 5. OMNICHANNEL & MESSAGING INTEGRATIONS (Optional)
# Integrated Baileys WhatsApp Service
WHATSAPP_API_URL="http://localhost:3001"
# Telegram Bot Emergency & Notification System
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"

# Speech-to-Text / Audio Transcription (MediaSuite STT or Whisper API)
MEDIASUITE_STT_URL="https://media.weblifetech.com/api/external/transcribe"
MEDIASUITE_API_TOKEN="your_mediasuite_or_stt_token"

# 6. EMAIL NOTIFICATIONS (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT=465
SMTP_USER="notifications@example.com"
SMTP_PASS="your_smtp_password"

# 7. OBSERVABILITY & LLM TRACING (Optional)
# Langfuse LLM Observability
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."

# LangSmith Tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="lefriapp-dev"
